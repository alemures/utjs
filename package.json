{
  "name": "utjs",
  "description": "utjs is a high performance library with some common functions like sort, concatArrays, randomString, stringToNumber, etc.",
  "version": "5.0.0",
  "author": "Alejandro Santiago Nieto",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.0.7",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^17.7.0",
    "prettier": "^3.5.3",
    "rollup": "^4.62.2",
    "typescript": "^7.0.2",
    "vitest": "^4.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    "types": "./dist/types/index.d.ts",
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cover": "vitest run --coverage",
    "build": "rollup --config && npm run types:generate",
    "lint": "eslint *.js lib/**/*.js test/**/*.js benchmark/**/*.js",
    "lint:fix": "npm run lint -- --fix",
    "types": "tsc",
    "types:generate": "tsc -p tsconfig.types.json",
    "check": "npm test && npm run lint && npm run types",
    "prepack": "npm run check && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alemures/utjs.git"
  }
}
